{
  "openapi": "3.1.0",
  "info": {
    "title": "Schema audit",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sumup.com"
    }
  ],
  "tags": [
    {
      "name": "Merchants",
      "description": "Merchant API."
    }
  ],
  "paths": {
    "/merchants": {
      "post": {
        "tags": ["Merchants"],
        "operationId": "CreateMerchant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Merchant"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created merchant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Merchant"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CountryCode": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "PhoneNumber": {
        "type": "string"
      },
      "Identifier": {
        "type": "string",
        "format": "uuid"
      },
      "LegalType": {
        "type": "string",
        "enum": ["sole_trader", "company"]
      },
      "Ownership": {
        "type": "object",
        "required": ["share"],
        "properties": {
          "share": {
            "type": "integer"
          }
        }
      },
      "Address": {
        "type": "object",
        "required": ["country"],
        "properties": {
          "country": {
            "allOf": [
              {
                "description": "Address country.",
                "example": "DE"
              },
              {
                "$ref": "#/components/schemas/CountryCode"
              }
            ]
          },
          "city": {
            "type": "string"
          }
        }
      },
      "Merchant": {
        "type": "object",
        "required": ["address", "phone_number", "id"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Local documentation."
          },
          "address": {
            "$ref": "#/components/schemas/Address",
            "description": "Local documentation."
          },
          "phone_number": {
            "$ref": "#/components/schemas/PhoneNumber",
            "description": "Local documentation."
          },
          "legal_type": {
            "$ref": "#/components/schemas/LegalType",
            "description": "Local documentation."
          },
          "ownership": {
            "$ref": "#/components/schemas/Ownership",
            "description": "Local documentation."
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address",
              "description": "Local documentation."
            }
          },
          "address_map": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Address",
              "description": "Local documentation."
            }
          },
          "extended_address": {
            "$ref": "#/components/schemas/ExtendedAddress",
            "description": "Extended address."
          },
          "country_codes": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "description": "Country item."
                },
                {
                  "$ref": "#/components/schemas/CountryAlias"
                }
              ]
            }
          }
        }
      },
      "ExtendedAddress": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Address",
            "description": "Inherited address."
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              }
            }
          }
        ]
      },
      "CountryAlias": {
        "allOf": [
          {
            "description": "Country alias."
          },
          {
            "$ref": "#/components/schemas/CountryCode"
          }
        ]
      }
    }
  }
}
